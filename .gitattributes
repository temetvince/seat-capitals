# Normalise every text file to LF in the repository and in the working tree,
# whatever the platform's default. Files Git cannot classify as text are left
# untouched; the explicit binary entries stop it guessing on common assets.
* text=auto eol=lf

*.php text eol=lf
*.blade.php text eol=lf
*.json text eol=lf
*.md text eol=lf
*.neon text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
