# Editor display settings only. Code style is enforced by .php-cs-fixer.dist.php.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,neon,yml,yaml,xml}]
indent_size = 2

[*.blade.php]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
